{
  "name": "@pixopen/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:font": "node scripts/generate-flip-note-font.mjs",
    "generate:on-air": "node scripts/generate-on-air-text.mjs",
    "generate:flip-note-figtree": "node scripts/generate-flip-note-figtree.mjs",
    "generate:weather-temp-figtree": "node scripts/generate-weather-temp-figtree.mjs",
    "generate:weather-sprites": "node scripts/build-weather-sprites.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pixopen/core": "*",
    "@pixopen/datasources": "*"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "typescript": "^5.8.3"
  }
}
